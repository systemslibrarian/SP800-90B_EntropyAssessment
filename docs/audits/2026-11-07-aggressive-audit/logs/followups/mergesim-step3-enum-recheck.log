== (5) run-all-checks.sh inventory parsing (comment handling), final tree lines 40-66
inventory_count=0
while IFS= read -r name || [ -n "${name}" ]; do
    # OC-121: COMMENTS AND BLANKS ARE SKIPPED, NOT REJECTED. The inventory had
    # never contained one, so the first comment ever added -- recording WHY
    # regression-constants.sh is deliberately last and must not be sorted back
    # into alphabetical order -- was rejected as a malformed entry. A file whose
    # ordering is load-bearing must be able to say so inside itself.
    case "${name}" in
        ''|'#'*) continue ;;
    esac
    case "${name}" in
        regression-[A-Za-z0-9]*.sh) ;;
        *) inventory_error "malformed entry ${name:-<empty>}" ;;
    esac
    case " ${inventory_names} " in
        *" ${name} "*) inventory_error "duplicate entry ${name}" ;;
    esac
    [ -f "./${name}" ] || inventory_error "required script ${name} is missing"
    [ -x "./${name}" ] || inventory_error "required script ${name} is not executable"
    inventory_names="${inventory_names} ${name}"
    inventory_count=$((inventory_count + 1))
done < "${REGRESSION_INVENTORY}"

[ "${inventory_count}" -eq "${EXPECTED_REGRESSION_SCRIPTS}" ] ||
    inventory_error "expected ${EXPECTED_REGRESSION_SCRIPTS} entries, found ${inventory_count}"

discovered_names=""
